{
  "schemaVersion": 1,
  "minimumTrestleVersion": "0.1.0-beta.1",
  "project": {
    "name": "easygardenplan"
  },
  "apps": {
    "site": true,
    "app": true,
    "worker": true
  },
  "tenancy": {
    "model": "organization",
    "enforcement": "postgres-rls"
  },
  "database": {
    "engine": "postgresql",
    "provider": "neon"
  },
  "capabilities": {
    "r2": false,
    "queues": true,
    "workflows": false,
    "durableObjects": false,
    "admin": false
  },
  "integrations": {
    "email": true,
    "billing": true
  },
  "environments": [
    "local",
    "preview",
    "staging",
    "production"
  ],
  "secrets": [
    {
      "name": "DATABASE_URL",
      "target": "worker",
      "required": ["local", "staging", "production"]
    },
    {
      "name": "DATABASE_DRIVER",
      "target": "worker",
      "required": ["local", "preview", "staging", "production"]
    },
    {
      "name": "BETTER_AUTH_SECRET",
      "target": "worker",
      "required": ["local", "preview", "staging", "production"]
    },
    {
      "name": "BETTER_AUTH_URL",
      "target": "worker",
      "required": ["local", "preview", "staging", "production"]
    },
    {
      "name": "RESEND_API_KEY",
      "target": "worker",
      "required": ["preview", "staging", "production"]
    },
    {
      "name": "RESEND_WEBHOOK_SECRET",
      "target": "worker",
      "required": ["preview", "staging", "production"]
    },
    {
      "name": "STRIPE_SECRET_KEY",
      "target": "worker",
      "required": ["preview", "staging", "production"]
    },
    {
      "name": "STRIPE_WEBHOOK_SECRET",
      "target": "worker",
      "required": ["preview", "staging", "production"]
    },
    {
      "name": "DATABASE_MIGRATION_URL",
      "target": "ci",
      "required": ["staging", "production"]
    },
    {
      "name": "NEON_API_KEY",
      "target": "ci",
      "required": ["preview", "staging", "production"]
    },
    {
      "name": "GEOAPIFY_API_KEY",
      "target": "worker",
      "required": ["staging", "production"]
    }
  ],
  "resources": [
    {
      "name": "Garden",
      "tenant": true,
      "crud": true,
      "fields": [
        { "name": "name", "type": "string", "required": true },
        { "name": "latitude", "type": "string", "required": false },
        { "name": "longitude", "type": "string", "required": false },
        { "name": "timezone", "type": "string", "required": false },
        { "name": "locationSource", "type": "string", "required": false },
        { "name": "locationProviderPlaceId", "type": "string", "required": false },
        { "name": "formattedAddress", "type": "string", "required": false },
        { "name": "units", "type": "string", "required": false },
        { "name": "conditions", "type": "text", "required": false },
        { "name": "monitoringEnabled", "type": "boolean", "required": false },
        { "name": "locationConfirmed", "type": "boolean", "required": false }
      ],
      "webhookEvents": [],
      "authorization": {
        "read": "garden.read",
        "write": "garden.write"
      },
      "pagination": {
        "defaultLimit": 25,
        "maxLimit": 100
      }
    }
  ]
}
