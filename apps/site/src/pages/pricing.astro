---
import PricingCard from "../components/PricingCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { appLink } from "../config/site";
const appUrl = import.meta.env.APP_URL ?? "http://localhost:42069";
---

<SiteLayout title="Pricing" description="Start with a complete free garden plan and add active weather guidance with Pro.">
  <section class="page-shell py-20 text-center sm:py-28"><p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Pricing</p><h1 class="display-title mx-auto mt-5 max-w-4xl text-5xl font-semibold sm:text-6xl">Plan for free. Add active guidance when you want it.</h1><p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-muted">Every gardener can map a space and build a schedule. Pro adds ongoing weather checks, frost alerts, and changing recommendations.</p></section>
  <section class="page-shell grid gap-5 pb-20 md:grid-cols-2"><PricingCard name="Free" price="$0" description="A complete self-guided garden plan." features={["One private garden", "Garden map and crop plan", "Planting schedule", "Weather and frost monitoring instructions"]} href={appLink("/sign-up?plan=free", appUrl)} cta="Plan my garden" /><PricingCard name="Pro" price="Coming soon" description="Active guidance through the season." features={["Everything in Free", "Forecast monitoring", "Frost and recovery alerts", "Timely planting recommendations"]} href={appLink("/sign-up?plan=pro", appUrl)} cta="Join Pro" featured /></section>
  <section class="page-shell pb-16"><div class="rounded-2xl border border-border bg-surface p-6 text-sm leading-7 text-muted"><strong class="text-foreground">Pricing is not billing state.</strong> A plan in the signup URL records non-authoritative intent only. Paid capabilities become active after verified provider state is committed to the application’s PostgreSQL subscription projection.</div></section>
</SiteLayout>
