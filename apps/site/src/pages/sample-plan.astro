---
import SiteLayout from "../layouts/SiteLayout.astro";
import { appLink } from "../config/site";
const appUrl = import.meta.env.APP_URL ?? "http://localhost:42069";
const tasks = [
  ["Feb 15", "Start tomatoes indoors"],
  ["Mar 10", "Direct-sow the first lettuce row"],
  ["Apr 1", "Check the seven-day forecast before transplanting"],
  ["Apr 8", "Transplant tomatoes and add basil after cold risk clears"],
];
---

<SiteLayout title="Sample garden plan" description="See the location, layout, calendar, and weather guidance in an Easy Garden Plan.">
  <section class="page-shell py-20 sm:py-28">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Sample plan</p>
    <h1 class="display-title mt-5 max-w-4xl text-5xl font-semibold sm:text-6xl">From a patch of ground to a season you can follow.</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-muted">This representative plan shows how the pieces fit together. It is an illustrative example, not advice for your garden.</p>
  </section>
  <section class="page-shell grid gap-6 pb-12 lg:grid-cols-2">
    <article class="rounded-3xl border border-border bg-surface p-7"><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">1 · Place</p><h2 class="mt-3 text-2xl font-semibold">Sacramento, California</h2><dl class="mt-6 grid grid-cols-2 gap-4 text-sm"><div><dt class="text-muted">Hardiness zone</dt><dd class="mt-1 font-semibold">9b</dd></div><div><dt class="text-muted">Sun</dt><dd class="mt-1 font-semibold">Full sun</dd></div><div><dt class="text-muted">Bed</dt><dd class="mt-1 font-semibold">4 × 3 meters</dd></div><div><dt class="text-muted">Frost dates</dt><dd class="mt-1 font-semibold">Manually confirmed</dd></div></dl></article>
    <article class="rounded-3xl border border-border bg-surface p-7"><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">2 · Layout</p><h2 class="mt-3 text-2xl font-semibold">A simple mixed bed</h2><div class="mt-6 grid h-48 grid-cols-4 grid-rows-3 gap-2 rounded-2xl bg-[#efe8d2] p-3 text-center text-xs font-semibold"><div class="col-span-2 row-span-2 flex items-center justify-center rounded-xl bg-[#bedb9c]">Tomatoes</div><div class="col-span-2 flex items-center justify-center rounded-xl bg-[#d7e9aa]">Lettuce</div><div class="flex items-center justify-center rounded-xl bg-[#9fd0a2]">Basil</div><div class="flex items-center justify-center rounded-xl bg-[#d7e9aa]">Lettuce</div><div class="col-span-2 flex items-center justify-center rounded-xl bg-[#d7e9aa]">Lettuce succession</div></div></article>
  </section>
  <section class="page-shell grid gap-6 pb-12 lg:grid-cols-[3fr_2fr]">
    <article class="rounded-3xl border border-border bg-surface p-7"><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">3 · Calendar</p><h2 class="mt-3 text-2xl font-semibold">The next useful job, in order</h2><ol class="mt-6 divide-y divide-border">{tasks.map(([date, task]) => <li class="grid grid-cols-[6rem_1fr] gap-4 py-4"><span class="font-semibold text-primary">{date}</span><span>{task}</span></li>)}</ol></article>
    <article class="rounded-3xl border border-border bg-[#fff8e8] p-7"><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">4 · Conditions</p><h2 class="mt-3 text-2xl font-semibold">A frost warning changes the plan</h2><p class="mt-4 leading-7 text-muted">If the forecast drops below the crop’s reviewed threshold, Pro sends one warning and pauses the affected task. It stays quiet while the same risk continues, then sends one clear message when the risk has passed.</p></article>
  </section>
  <section class="page-shell pb-20"><div class="rounded-3xl bg-foreground p-8 text-background sm:flex sm:items-center sm:justify-between"><div><h2 class="text-2xl font-semibold">Build a plan around your own garden.</h2><p class="mt-2 text-background/75">You can revise the layout, schedule, and completed work throughout the season.</p></div><a class="mt-6 inline-flex rounded-full bg-primary px-6 py-3 font-semibold text-white sm:mt-0" href={appLink("/sign-up", appUrl)}>Plan my garden</a></div></section>
</SiteLayout>
