---
import FeatureCard from "../components/FeatureCard.astro";
import PricingCard from "../components/PricingCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { appLink, site } from "../config/site";

const appUrl = import.meta.env.APP_URL ?? "http://localhost:42069";
---

<SiteLayout>
  <section class="page-shell grid items-center gap-12 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-28">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Grow with a plan</p>
      <h1 class="display-title mt-5 max-w-4xl text-5xl font-semibold leading-[1.02] tracking-tight sm:text-7xl">{site.tagline}</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-muted">{site.description}</p>
      <div class="mt-9 flex flex-wrap gap-4"><a class="rounded-xl bg-primary px-6 py-3 font-semibold text-white transition hover:bg-primary-strong" href={appLink("/sign-up", appUrl)}>Get started</a><a class="rounded-xl border border-border bg-surface px-6 py-3 font-semibold hover:border-primary" href="/pricing">View pricing</a></div>
    </div>
    <div class="surface-card relative overflow-hidden p-6 sm:p-8">
      <div class="absolute right-0 top-0 h-36 w-36 rounded-full bg-primary/15 blur-3xl"></div>
      <p class="text-sm font-semibold text-muted">Your garden at a glance</p>
      <div class="mt-6 space-y-4">
        <div class="rounded-2xl border border-border bg-background p-5"><p class="text-xs font-bold uppercase tracking-wider text-primary">Next up</p><p class="mt-2 font-semibold">Start tomatoes indoors</p><p class="mt-1 text-sm text-muted">Based on your frost window</p></div>
        <div class="grid grid-cols-2 gap-4"><div class="rounded-2xl border border-border bg-surface p-5"><p class="text-3xl font-semibold">8</p><p class="mt-1 text-sm text-muted">Plants planned</p></div><div class="rounded-2xl border border-border bg-surface p-5"><p class="text-3xl font-semibold">3</p><p class="mt-1 text-sm text-muted">Beds mapped</p></div></div>
      </div>
    </div>
  </section>

  <section class="page-shell py-16" aria-labelledby="value-heading"><p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">From yard to calendar</p><h2 id="value-heading" class="display-title mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">Know what to plant, where it fits, and when to act.</h2><div class="mt-10 grid gap-5 md:grid-cols-3"><FeatureCard eyebrow="Locate" title="Start with your conditions" description="Use your garden location, growing zone, sun, and local frost dates as the foundation." /><FeatureCard eyebrow="Map" title="Draw the space you have" description="Place beds and growing areas on a map so the plan reflects your real garden." /><FeatureCard eyebrow="Schedule" title="Get useful next steps" description="Turn crop choices into clear planting tasks, weather checks, and timely reminders." /></div></section>

  <section class="page-shell py-16"><div class="surface-card grid gap-10 p-8 sm:p-12 lg:grid-cols-3"><div><p class="text-sm font-bold uppercase tracking-wider text-primary">01 · Place</p><h3 class="mt-3 text-xl font-semibold">Find your garden</h3><p class="mt-3 leading-7 text-muted">Confirm the exact spot and the conditions that shape it.</p></div><div><p class="text-sm font-bold uppercase tracking-wider text-primary">02 · Plan</p><h3 class="mt-3 text-xl font-semibold">Choose plants and beds</h3><p class="mt-3 leading-7 text-muted">Lay out the growing space and decide what you want to harvest.</p></div><div><p class="text-sm font-bold uppercase tracking-wider text-primary">03 · Grow</p><h3 class="mt-3 text-xl font-semibold">Follow the schedule</h3><p class="mt-3 leading-7 text-muted">Work through timely tasks and adjust as weather changes.</p></div></div></section>

  <section class="page-shell py-16" aria-labelledby="pricing-preview"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Simple pricing</p><h2 id="pricing-preview" class="display-title mt-4 text-4xl font-semibold sm:text-5xl">Build the plan for free. Add active guidance later.</h2></div><a class="font-semibold text-primary hover:text-primary-strong" href="/pricing">See every plan →</a></div><div class="mt-10 grid gap-5 md:grid-cols-2"><PricingCard name="Free" price="$0" description="Plan one garden from map to schedule." features={["Private garden", "Bed layout", "Planting schedule"]} href={appLink("/sign-up?plan=free", appUrl)} cta="Plan my garden" /><PricingCard name="Pro" price="Coming soon" description="Stay ahead of changing conditions." features={["Weather monitoring", "Frost alerts", "Updated recommendations"]} href={appLink("/sign-up?plan=pro", appUrl)} cta="Join Pro" featured /></div></section>

  <section class="page-shell py-16"><div class="overflow-hidden rounded-[2rem] bg-foreground px-7 py-14 text-center text-white sm:px-12"><p class="text-sm font-bold uppercase tracking-[0.2em] text-white/65">Make this season easier</p><h2 class="display-title mx-auto mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">Start with your garden and leave with a plan.</h2><a class="mt-8 inline-block rounded-xl bg-white px-6 py-3 font-semibold text-foreground transition hover:bg-background" href={appLink("/sign-up", appUrl)}>Plan my garden</a></div></section>
</SiteLayout>
