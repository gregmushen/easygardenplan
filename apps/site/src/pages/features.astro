---
import FeatureCard from "../components/FeatureCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { appLink } from "../config/site";
const appUrl = import.meta.env.APP_URL ?? "http://localhost:42069";
---

<SiteLayout title="Features" description="Map a growing space and turn crop choices into a local planting schedule.">
  <section class="page-shell py-20 sm:py-28"><p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Features</p><h1 class="display-title mt-5 max-w-4xl text-5xl font-semibold sm:text-6xl">One plan from first sketch to harvest.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-muted">Easy Garden Plan connects your location, growing space, crop choices, seasonal tasks, and weather signals.</p></section>
  <section class="page-shell grid gap-5 pb-20 md:grid-cols-2"><FeatureCard eyebrow="Location" title="Understand your growing conditions" description="Start from your address, zone, frost window, local climate, and the exact place you grow." /><FeatureCard eyebrow="Layout" title="Map beds of any shape" description="Draw the spaces you actually use and keep dimensions and planting area together." /><FeatureCard eyebrow="Schedule" title="Know what to do next" description="Turn plant choices into a clear sequence for starting, transplanting, caring, and harvesting." /><FeatureCard eyebrow="Weather" title="Adjust when conditions change" description="Use current forecasts and frost risk to make practical changes at the right time." /></section>
  <section class="page-shell pb-16"><div class="surface-card flex flex-col items-start justify-between gap-6 p-8 sm:flex-row sm:items-center"><div><h2 class="display-title text-3xl font-semibold">Ready to plan your growing season?</h2><p class="mt-2 text-muted">Create a free garden and add detail as you go.</p></div><a class="shrink-0 rounded-xl bg-primary px-6 py-3 font-semibold text-white hover:bg-primary-strong" href={appLink("/sign-up", appUrl)}>Get started</a></div></section>
</SiteLayout>
